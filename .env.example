# BrandGuard AI — Root Environment Reference (Phase 3)
# Refer to backend/.env.example and frontend/.env.example for component-specific configurations.

# Backend — Gemini AI Review (Server-Side ONLY — Never expose to client)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=15.0
GEMINI_MAX_RETRIES=2
GEMINI_ENABLED=true

# Backend — Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./backend/serviceAccountKey.json
USE_FIRESTORE=false
ENABLE_DEMO_AUTH=true

# Frontend — Vite Firebase Client SDK
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
