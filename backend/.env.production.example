# ==============================================================================
# BrandGuard AI - Backend Production Environment Configuration
# ==============================================================================
# Configure these variables in your hosting provider's dashboard (e.g. Render, Railway, Cloud Run).
# NEVER commit the actual .env file or real secrets to git!

# Environment mode ('production' enforces fail-closed auth, real Firebase, and masks tracebacks)
ENVIRONMENT=production
LOG_LEVEL=INFO

# Firebase Configuration
# Option A: Paste full raw JSON string or base64 of service account key (RECOMMENDED for Render)
FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "brandguard-ai-techwithmujju", ...}
# Option B: Mount service account json as secret file and provide path
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=/etc/secrets/firebase-service-account.json
# Option C: Use Google Application Default Credentials or Project ID on GCP
FIREBASE_PROJECT_ID=brandguard-ai-techwithmujju

# Initial organization administrator bootstrap (first login with this email gets admin role)
BOOTSTRAP_ADMIN_EMAIL=judge.admin@inkloom-brandguard.com

# Enable live cloud Firestore persistence (fails closed if unavailable)
USE_FIRESTORE=true

# Strictly disable demo authentication & role impersonation in production
ENABLE_DEMO_AUTH=false

# Google Gemini API Settings (SERVER-SIDE ONLY — NEVER EXPOSE TO FRONTEND)
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TIMEOUT_SECONDS=15.0
GEMINI_MAX_RETRIES=2
GEMINI_ENABLED=true

# CORS Allowed Origins (Comma-separated list of allowed frontend domains)
CORS_ORIGINS=https://brandguard-ai-phi.vercel.app,https://brandguard-ai.vercel.app

# API Rate Limits (requests per minute)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_CHECK_PER_MINUTE=30
