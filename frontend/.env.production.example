# ==============================================================================
# BrandGuard AI - Frontend Production Environment Configuration (Vercel)
# ==============================================================================
# Set these variables in the Vercel Project Settings -> Environment Variables.

# URL of the hosted FastAPI production backend (e.g. Render, Railway, Cloud Run)
VITE_API_BASE_URL=https://brandguard-api.onrender.com

# Firebase Client Web App Configuration (from Firebase Console -> Project Settings -> General -> Web App)
VITE_FIREBASE_API_KEY=AIzaSyA...
VITE_FIREBASE_AUTH_DOMAIN=brandguard-governance.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=brandguard-governance
VITE_FIREBASE_STORAGE_BUCKET=brandguard-governance.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Disable demo identity switching in production (forces real Firebase Authentication)
VITE_ENABLE_DEMO_AUTH=false
